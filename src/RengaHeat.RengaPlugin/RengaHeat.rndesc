<?xml version="1.0" encoding="utf-8"?>
<!--
  Дескриптор плагина Renga (.rndesc), схема для плагинов .NET 8.
  RequiredAPIVersion должен соответствовать версии установленного Renga SDK
  (здесь 2.48 — под Renga.NET8.PluginUtility 2.48.x). PluginFilename и тип точки входа
  должны совпадать с собранной DLL.
-->
<RengaPlugin>
  <Name>RengaHeat — гидравлический расчёт отопления</Name>
  <!-- Renga требует версию из двух чисел (X.Y). Трёхчастный формат (0.1.0) отбраковывается. -->
  <Version>1.0</Version>
  <RequiredAPIVersion>2.48</RequiredAPIVersion>
  <Vendor>RengaHeat</Vendor>
  <Copyright>RengaHeat</Copyright>
  <PluginFilename>RengaHeat.RengaPlugin.dll</PluginFilename>
  <PluginType>Net8</PluginType>
</RengaPlugin>
